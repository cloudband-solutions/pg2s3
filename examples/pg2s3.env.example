PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme

AWS_S3_BUCKET=my-backups
AWS_S3_PREFIX=postgres

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAEXAMPLE
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

PG2S3_LOG_FILE=/var/log/pg2s3.log

